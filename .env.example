# Copy to .env.local and fill in. See docs/06-setup.md for where each value comes from.

# --- Phase 1: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Phase 2: YouTube + cron (server only) ---
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- Phase 3: site ---
# Admins are granted in SQL: insert into public.admin_emails (email) values ('you@example.com');
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_URL=

# --- Local Supabase Google login (read by supabase/config.toml) ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- Phase 4: notifications ---
WEBSUB_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
