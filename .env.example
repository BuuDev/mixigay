# Copy to .env.local and fill in. See docs/06-setup.md for where each value comes from.

# --- Phase 1: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Phase 2: YouTube + cron (server only) ---
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- Phase 3: site ---
# First owner: in the SQL editor run  select public.issue_invite('owner', 'ten-ban', 'Tên bạn');  then open $SITE/moi/<token>.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_URL=

# --- Accounts (ADR-013) ---
# HMAC salt for hashing IPs in sign-up / sign-in rate limits (any long random string).
AUTH_HASH_SALT=
# Optional Cloudflare Turnstile on account creation (leave empty to rely on rate limits).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Phase 4: notifications ---
WEBSUB_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
# Admin-only alerts when the moderation queue spikes (a private group, not the fans' channel)
ADMIN_ALERT_TELEGRAM_CHAT_ID=
ADMIN_ALERT_DISCORD_WEBHOOK_URL=

# Google Cloud Vision (optional): automated SafeSearch + OCR check of fan-uploaded game thumbnails.
# Unset: every upload simply waits for manual admin review. docs/04-integrations.md
GOOGLE_VISION_API_KEY=
