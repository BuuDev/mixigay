# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local mood-board images (third-party logos/photos) — never published or committed.
/design-refs/

# Owner uploads before review (raw photos, official logos): never served, never committed.
/assets-raw/

# Original artwork (large PNGs); the site uses the WebP copies in public/art
/design-src/

# Supabase CLI cache (linked project ref, pooler URL)
/supabase/.temp/
